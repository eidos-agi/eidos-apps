    },
    {
      "id": "opf:eidos-apps:decision:not-applet",
      "type": "decision",
      "title": "Eidos Apps, not Applets, not Prim App",
      "status": "active",
      "description": "Applets stay tiny workers. Apps are Docker images. Prim.app stays the host. prim.eidosagi.com is a look surface, not an App.",
      "rationale": {
        "why": "A director that plays a film and waits on a human yes will not fit Look. Growing an applet until it is an app kills both. Prim.app already owns that name.",
        "problems": [],
        "alternatives": [
          {
            "option": "Grow eidos-applets until Eidos Video fits",
            "disposition": "ruled-out",
            "reason": "Applets charter: do not grow Applets until they are Apps."
          },
          {
            "option": "Call it prim-apps / Prim App",
            "disposition": "ruled-out",
            "reason": "Prim.app is the double-click host."
          },
          {
            "option": "Make prim.eidosagi.com an Eidos App",
            "disposition": "ruled-out",
            "reason": "A catalog is how you look, not a gated Docker program."
          }
        ],
        "revisit_when": ["An App image actually runs.", "A second App is declared besides Eidos Video."]
      },
      "provenance": {"by": "human:daniel", "method": "Corrected prim-apps to Eidos App"}
    },
    {
      "id": "opf:eidos-apps:decision:docker-image",
      "type": "decision",
      "title": "The App is a Docker image",
      "status": "active",
      "description": "One image per app. The pack is app.json plus a Dockerfile that EXPOSEs a port. Applets stay workers with no listen-port. This repo declares; it does not orchestrate.",
      "rationale": {
        "why": "Workers and containers are different run units. Mixing them is how the split dies.",
        "problems": [],
        "alternatives": [
          {
            "option": "Any binary or local worker that fills app.json",
            "disposition": "ruled-out",
            "reason": "Lets Applets grow into this space. Daniel: eidos apps will be docker images."
          },
          {
            "option": "Kubernetes or a manager in this repo",
            "disposition": "ruled-out",
            "reason": "Declare the image. Do not invent an orchestrator."
          },
          {
            "option": "Delete Docker from the category until two apps exist",
            "disposition": "ruled-out",
            "reason": "LOOK-0001 F-0003. Category lock is the image, not a later convenience."
          }
        ],
        "revisit_when": ["An App image actually runs.", "A second App image exists besides Eidos Video."]
      },
      "provenance": {"by": "human:daniel", "method": "Chat 2026-08-22: eidos apps will be docker images"}
    }
  ],
