      "id": "opf:eidos-apps:intent",
      "type": "intent",
      "title": "Declare Eidos Apps as Docker images without growing Applets or renaming Prim.app",
      "status": "active",
      "description": "Types, app.json, Dockerfile, gates. Real surfaces. Agent drafts; human yes is a record elsewhere.",
      "content": "content/north-star.md",
